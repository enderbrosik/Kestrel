  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  }
}
