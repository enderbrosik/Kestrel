{
  "name": "kestrel",
  "version": "0.1.0",
  "description": "Kestrel: an open-source code editor built on Monaco and Tauri, meant to replace VS Code.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
